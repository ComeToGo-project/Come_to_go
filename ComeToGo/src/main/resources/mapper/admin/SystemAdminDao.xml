<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cometogo.ctg.admin.dao.SystemAdminDao">
    <select id="findAllCategories" resultType="com.cometogo.ctg.admin.dto.SystemAdminDto">
        SELECT category_id, parent_id, category_name FROM ctg_categories
    </select>

    <insert id="addCategory" parameterType="map">
        INSERT INTO ctg_categories (category_name, parent_id) VALUES (#{categoryName}, #{parentId})
    </insert>

    <select id="countCategoryUsedInGroups" parameterType="long" resultType="int">
        SELECT COUNT(*) FROM ctg_group WHERE category_id = #{categoryId}
    </select>

    <delete id="deleteCategory" parameterType="long">
        DELETE FROM ctg_categories WHERE category_id = #{categoryId}
    </delete>
</mapper>