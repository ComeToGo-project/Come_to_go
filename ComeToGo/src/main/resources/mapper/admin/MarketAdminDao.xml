<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cometogo.ctg.admin.dao.MarketAdminDao">
    <select id="findMarketItems" resultType="com.cometogo.ctg.admin.dto.MarketAdminDto">
        SELECT m.item_id,
        m.item_name,
        u.user_id,
        u.user_name,
        l.city,
        m.created_at,
        m.status
        FROM market m
        JOIN ctg_users u ON m.seller_id = u.user_id
        JOIN ctg_group g ON m.group_id = g.group_id
        LEFT JOIN ctg_group_location l ON g.group_id = l.group_id
        <where>
            <if test="filterType != null and keyword != null and keyword != ''">
                <choose>
                    <when test="filterType == 'itemName'">
                        m.item_name LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test="filterType == 'userName'">
                        u.user_name LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                </choose>
            </if>
            <if test="status != null and status != ''">
                AND m.status = #{status}
            </if>
        </where>
        ORDER BY m.created_at DESC
    </select>

    <delete id="deleteItemImages" parameterType="long">
        DELETE FROM item_image WHERE item_id = #{itemId}
    </delete>

    <delete id="deleteMarketChats" parameterType="long">
        DELETE FROM market_chat WHERE item_id = #{itemId}
    </delete>

    <delete id="deleteMarketItem" parameterType="long">
        DELETE FROM market WHERE item_id = #{itemId}
    </delete>
</mapper>